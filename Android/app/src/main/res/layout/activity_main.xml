<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Camera preview on the phone (the encoder gets its own copy from the camera) -->
    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/preview_note"
        style="@style/Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="120dp"
        android:text="@string/preview_off"
        android:visibility="gone" />

    <!-- Status chip -->
    <LinearLayout
        android:id="@+id/status_chip"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/dot" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom card -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/title"
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_computer" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/choose_hint" />

        <!-- Pick a computer -->
        <LinearLayout
            android:id="@+id/pick_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pc_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/searching"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/searching" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/manual_toggle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:text="@string/type_address"
                    android:textColor="@color/accent"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/settings_link"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:text="@string/settings"
                    android:textColor="@color/accent"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/manual_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/address"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/connect"
                    style="@style/BigButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_primary"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/connect"
                    android:textColor="@color/on_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Connected -->
        <LinearLayout
            android:id="@+id/live_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/flip"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="@string/switch_camera"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/torch"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="@string/light_off"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="@string/settings"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/disconnect"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_danger"
                    android:text="@string/disconnect"
                    android:textColor="@color/bad" />
            </LinearLayout>

            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/keep_open"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Permission needed -->
        <Button
            android:id="@+id/grant"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary"
            android:text="@string/grant"
            android:textColor="@color/on_accent"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Settings (filled in code) -->
    <ScrollView
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp" />
    </ScrollView>
</FrameLayout>
